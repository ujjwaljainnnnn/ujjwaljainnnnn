# Default reasoning engine when the frontend doesn't specify one: "anthropic" or "openai".
# The frontend's Model Switcher lets users pick per-request; this is only the fallback default.
AI_PROVIDER=anthropic

# Configure either or both providers. Any provider selected in the UI whose key is missing
# (or whose call fails) transparently falls back to the built-in heuristic technical-analysis
# engine, so the app stays fully functional with zero, one, or both keys configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
