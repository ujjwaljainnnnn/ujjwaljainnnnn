# Which LLM provider to use for the Copilot's reasoning engine: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Provide the key for whichever provider you selected above.
# Leaving both unset runs the built-in heuristic technical-analysis fallback instead of an LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
